 "lines": [
  {
   "who": "dev",
   "text": "Claude... why is our cloud bill eighty-two thousand dollars?",
   "shot": "wide",
   "dev": "worried",
   "cap": "Claude... why is our cloud bill $82,000?",
   "i": 0,
   "start": 0.7,
   "end": 4.269
  },
  {
   "who": "claude",
   "text": "You put the API key in the front end.",
   "shot": "buddy",
   "claude": "neutral",
   "i": 1,
   "start": 4.609,
   "end": 6.634
  },
  {
   "who": "dev",
   "text": "When?",
   "shot": "devpunch",
   "dev": "shocked",
   "gesture": "hands",
   "i": 2,
   "start": 6.974,
   "end": 7.311
  },
  {
   "who": "claude",
   "text": "In the commit called, final final fix.",
   "shot": "screen",
   "screen": "commits",
   "claude": "neutral",
   "cap": "In the commit called \"final final fix.\"",
   "i": 3,
   "start": 7.651,
   "end": 10.149
  },
  {
   "who": "dev",
   "text": "Okay. Just delete the commit.",
   "shot": "devleft",
   "dev": "neutral",
   "gesture": "point",
   "i": 4,
   "start": 10.489,
   "end": 12.471
  },
  {
   "who": "claude",
   "text": "It's public. It has three stars.",
   "shot": "screen",
   "screen": "stars",
   "claude": "neutral",
   "i": 5,
   "start": 12.811,
   "end": 15.419
  },
  {
   "who": "dev",
   "text": "We have fans?",
   "shot": "dev",
   "dev": "happy",
   "pause": 0.3,
   "i": 6,
   "start": 15.719,
   "end": 16.528
  },
  {
   "who": "claude",
   "text": "They're the ones using your key.",
   "shot": "ots",
   "claude": "flat",
   "pause": 0.4,
   "i": 7,
   "start": 16.928,
   "end": 18.513
  },
  {
   "who": "dev",
   "text": "Rotate it. Now.",
   "shot": "wide",
   "dev": "worried",
   "gesture": "facepalm",
   "pause": 0.9,
